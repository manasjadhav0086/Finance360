# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=finance_data
MYSQL_USER=app_user
MYSQL_PASSWORD=replace_me

# Application Configuration
APP_NAME=Finance360
PORT=4820
NODE_ENV=production
JWT_SECRET=replace_with_strong_jwt_secret
DEFAULT_ADMIN_PASSWORD=replace_with_secure_admin_password
DEFAULT_USER_PASSWORD=Welcome@Finance360
APP_URL=http://localhost:3000

# Email Delivery / SMTP Configuration (e.g., Gmail, SendGrid, Amazon SES, Mailgun)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Finance360 Platform" <no-reply@finance360.local>
