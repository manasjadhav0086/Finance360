# ===================================================
# Finance360 Backend — Environment Configuration
# ===================================================

# Database Connection (TiDB Cloud Starter or Local MySQL 8.0)
# Local default: 127.0.0.1 / 3306
# TiDB Cloud example: gateway01.ap-south-1.prod.aws.tidbcloud.com / 4000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=finance_data
MYSQL_USER=finance360_app
MYSQL_PASSWORD=replace_with_database_password

# Database TLS/SSL & Serverless Connection Pool
# Set MYSQL_SSL=true for TiDB Cloud (enforces TLS 1.2+); false for local MySQL
MYSQL_SSL=false
# Maximum connections in pool per serverless instance (recommended 2-5 for Vercel, 10 for local)
MYSQL_CONNECTION_LIMIT=3
# Connection timeout in milliseconds
MYSQL_CONNECT_TIMEOUT=10000

# Application Configuration
APP_NAME=Finance360
PORT=4820
NODE_ENV=production

# Authentication Secret (Generate a strong 32+ character random secret)
JWT_SECRET=replace_with_strong_jwt_secret

# Production Frontend URL (Used to construct password-reset and invite email links)
# In production, set to your live Vercel frontend URL: https://<your-frontend-project>.vercel.app
# In local dev: http://localhost:3000
APP_URL=http://localhost:3000

# Admin Defaults (Used during initial setup/seed if needed)
ADMIN_EMAIL=admin@misar.io
DEFAULT_ADMIN_PASSWORD=replace_with_secure_admin_password
DEFAULT_USER_PASSWORD=Welcome@Finance360

# Email Delivery / SMTP Configuration (Optional - Brevo, Gmail, or corporate SMTP)
# If left blank, invite and password setup links will be returned directly in the admin API response
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASS=replace_with_smtp_password
SMTP_FROM="Finance360 Platform" <noreply@yourdomain.com>
