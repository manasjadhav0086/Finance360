# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=finance_data
MYSQL_USER=app_user
MYSQL_PASSWORD=replace_me

# Application Configuration
APP_NAME=Finance360
PORT=4820
NODE_ENV=production
JWT_SECRET=replace_with_strong_jwt_secret
ADMIN_EMAIL=admin@misar.io
DEFAULT_ADMIN_PASSWORD=replace_with_secure_admin_password
DEFAULT_USER_PASSWORD=Welcome@Finance360
APP_URL=http://localhost:3000

# Email Delivery / SMTP Configuration (e.g. mail.misar.io, SendGrid, Amazon SES)
SMTP_HOST=mail.misar.io
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=finance360@misar.io
SMTP_PASS=replace_with_smtp_password
SMTP_FROM="Finance360 Platform" <finance360@misar.io>
