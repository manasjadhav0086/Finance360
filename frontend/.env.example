# ===================================================
# Finance360 Frontend — Environment Configuration
# ===================================================

# In production on Vercel:
# Set VITE_API_BASE_URL to your deployed backend API URL including the /fin/api path.
# Example: https://finance360-backend.vercel.app/fin/api
#
# In local development:
# Leave empty to use Vite's built-in reverse proxy (http://localhost:3000/fin/api -> http://127.0.0.1:4820/fin/api)
VITE_API_BASE_URL=
