# Finance360 Frontend - Environment Configuration for Vercel / Production
# If your backend API is hosted separately (e.g. Render, Railway, AWS, or custom domain):
# Set VITE_API_BASE_URL to your deployed backend API URL (including the /fin/api suffix).
# Example: https://api.yourdomain.com/fin/api
# If left empty, it defaults to /fin/api (same-origin / reverse proxy).
VITE_API_BASE_URL=
