{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/fin/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/fin/favicon.png",
      "destination": "/favicon.png"
    },
    {
      "source": "/fin/finance360_logo.png",
      "destination": "/finance360_logo.png"
    },
    {
      "source": "/fin/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
